# .env.example
# Create a .env.local file in your frontend and a .env file for your backend syncing script

# Frontend Variables (Public)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Backend Synchronization Script Variables (Private, DO NOT expose to frontend)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REFRESH_TOKEN=your-google-refresh-token
GOOGLE_ACCESS_TOKEN=your-temporary-access-token
GOOGLE_BUSINESS_ACCOUNT_ID=your-account-id
GOOGLE_BUSINESS_LOCATION_ID=your-location-id

# Config
GOOGLE_REVIEW_SYNC_INTERVAL=1800
